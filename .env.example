OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional SMTP settings for emailing the shared JAXO Premium key
JAXO_SMTP_HOST=smtp.example.com
JAXO_SMTP_PORT=587
JAXO_SMTP_USER=your_email_username
JAXO_SMTP_PASSWORD=your_email_app_password
JAXO_EMAIL_FROM=JAXO <you@example.com>
